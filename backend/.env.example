# Obtené estas credenciales en https://my.telegram.org/apps
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here

# Se genera automáticamente al loguearte por primera vez
# Copialo aquí para no tener que loguearte cada vez que reiniciás
TG_SESSION=

# Railway persiste el volumen en /data — cambiá el path si querés
DB_PATH=./teldrive.db

# URL de tu frontend (para CORS)
FRONTEND_URL=https://tu-app.vercel.app

PORT=3001
